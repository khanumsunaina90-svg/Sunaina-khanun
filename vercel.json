{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "static",
      "public": true
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm install",
      "devCommand": "npm run dev",
      "installCommand": "npm install",
      "public": false,
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "bindings": []
}
